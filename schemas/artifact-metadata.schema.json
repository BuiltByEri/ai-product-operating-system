{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aapos/schemas/artifact-metadata.schema.json",
  "title": "AAPOS Artifact Metadata",
  "type": "object",
  "required": ["aapos_artifact"],
  "additionalProperties": false,
  "properties": {
    "aapos_artifact": {
      "type": "object",
      "required": ["id", "name", "version", "stage", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "artifact.discovery_summary",
            "artifact.product_recommendation",
            "artifact.engineering_refinement_package",
            "artifact.engineering_refinement_workbook_map",
            "artifact.engineering_readiness_review",
            "artifact.approval_record"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "stage": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    }
  }
}
